/**
 * telegramBot.js — Telegram-часть
 * Отвечает за:
 *  - отправку сообщений / фото в Telegram
 *  - получение команд от пользователя и передачу их в Minecraft-бот
 */

const TelegramBot = require('node-telegram-bot-api');
const cfg = require('./config');

/** @type {TelegramBot} */
let tg = null;

/** Состояния ожидания ввода от пользователя */
const waitState = {
  captcha: false,  // ждём текст капчи
  chat: false,     // ждём произвольный текст для чата
};

/** Колбэки, устанавливаемые из mcBot.js */
const handlers = {
  onCaptchaText: null,   // (text) => void
  onChatText: null,      // (text) => void
  onSetIp: null,         // (host, port) => void
  onSlotClick: null,     // (slotIndex) => void
  onStartFarm: null,     // () => void
  onStopFarm: null,      // () => void
  onLook: null,          // (yaw, pitch) => void
  onSayText: null,       // (text) => void
  onUseCompass: null,    // () => void
  onStatus: null,        // () => void
};

/**
 * Инициализирует Telegram-бота и регистрирует все обработчики.
 * @param {Object} externalHandlers — объект с колбэками из mcBot.js
 */
function init(externalHandlers) {
  Object.assign(handlers, externalHandlers);

  tg = new TelegramBot(cfg.TG_TOKEN, { polling: true });

  // ── /start ──────────────────────────────────────────────────────────────
  tg.onText(/\/start/, () => {
    sendMessage(
      '🤖 *Minecraft Bot активен*\n\n' +
      'Доступные команды:\n' +
      '`/start_farm` — начать фарм (удары)\n' +
      '`/stop_farm` — остановить фарм\n' +
      '`/look <yaw> <pitch>` — повернуть взгляд (углы)\n' +
      '`/look <north|south|west|east|up|down>` — повернуть взгляд (направление)\n' +
      '`/say <текст>` — отправить текст в чат MC\n' +
      '`/chat` — войти в режим чата (всё последующее → в MC)\n' +
      '`/stopchat` — выйти из режима чата\n' +
      '`/usecompass` — нажать правой кнопкой мыши с компасом в руке\n' +
      '`/setip <host> [port]` — сменить IP сервера и переподключиться\n' +
      '`/status` — текущий статус бота',
      { parse_mode: 'Markdown' }
    );
  });

  // ── /start_farm ──────────────────────────────────────────────────────────
  tg.onText(/\/start_farm/, () => {
    handlers.onStartFarm?.();
    sendMessage('⚔️ Фарм запущен');
  });

  // ── /stop_farm ───────────────────────────────────────────────────────────
  tg.onText(/\/stop_farm/, () => {
    handlers.onStopFarm?.();
    sendMessage('🛑 Фарм остановлен');
  });

  // ── /look ─────────────────────────────────────────────────────────────────
  tg.onText(/\/look (.+)/, (msg, match) => {
    const input = match[1].trim();

    // Поддержка формата Minecraft F3: "XX/XX" или "XX / XX" (градусы)
    const f3Match = input.match(/([\-\d\.]+)\s*\/\s*([\-\d\.]+)/);
    if (f3Match) {
      const mcYaw = parseFloat(f3Match[1]);
      const mcPitch = parseFloat(f3Match[2]);
      if (!isNaN(mcYaw) && !isNaN(mcPitch)) {
        const yaw = mcYaw * Math.PI / 180;
        const pitch = mcPitch * Math.PI / 180;
        handlers.onLook?.(yaw, pitch);
        sendMessage(`👁 Смотрю (F3): yaw=${mcYaw}°, pitch=${mcPitch}°`);
        return;
      }
    }

    const args = input.split(/\s+/);
    const dirs = {
      north: { yaw: Math.PI, pitch: 0 },
      south: { yaw: 0, pitch: 0 },
      west:  { yaw: Math.PI / 2, pitch: 0 },
      east:  { yaw: -Math.PI / 2, pitch: 0 },
      up:    { yaw: 0, pitch: -Math.PI / 2 },
      down:  { yaw: 0, pitch: Math.PI / 2 },
    };

    if (dirs[args[0]?.toLowerCase()]) {
      const d = dirs[args[0].toLowerCase()];
      handlers.onLook?.(d.yaw, d.pitch);
      sendMessage(`👁 Смотрю на: ${args[0]}`);
    } else if (args.length >= 2) {
      const yaw   = parseFloat(args[0]);
      const pitch = parseFloat(args[1]);
      if (!isNaN(yaw) && !isNaN(pitch)) {
        handlers.onLook?.(yaw, pitch);
        sendMessage(`👁 Смотрю: yaw=${yaw} pitch=${pitch}`);
      } else {
        sendMessage('❌ Неверный формат. Пример: `/look north`, `/look 3.14 0` или `/look 180/0` (из F3)');
      }
    } else {
      sendMessage('❌ Укажите направление, два угла или значения из F3 (XX/XX). Пример: `/look 180/0`');
    }
  });

  // ── /say ──────────────────────────────────────────────────────────────────
  tg.onText(/\/say (.+)/, (msg, match) => {
    const text = match[1].trim();
    handlers.onSayText?.(text);
    sendMessage(`✉️ Отправлено в чат MC: ${text}`);
  });

  // ── /chat (режим непрерывного чата) ─────────────────────────────────────
  tg.onText(/\/chat$/, () => {
    waitState.chat = true;
    waitState.captcha = false;
    sendMessage(
      '💬 *Режим чата активен*\nВсё, что вы пишете — отправляется в MC.\nВыход: `/stopchat`',
      { parse_mode: 'Markdown' }
    );
  });

  tg.onText(/\/stopchat/, () => {
    waitState.chat = false;
    sendMessage('🔇 Режим чата отключён');
  });

  // ── /usecompass ──────────────────────────────────────────────────────────
  tg.onText(/\/usecompass/, () => {
    handlers.onUseCompass?.();
    sendMessage('🧭 Использую компас...');
  });

  // ── /setip ────────────────────────────────────────────────────────────────
  tg.onText(/\/setip (.+)/, (msg, match) => {
    const parts = match[1].trim().split(/\s+/);
    const host  = parts[0];
    const port  = parseInt(parts[1] || '25565', 10);
    if (!host) {
      sendMessage('❌ Укажите хост. Пример: `/setip play.example.com 25565`');
      return;
    }
    handlers.onSetIp?.(host, port);
    sendMessage(`🔄 Переподключение к ${host}:${port}…`);
  });

  // ── /status ───────────────────────────────────────────────────────────────
  tg.onText(/\/status/, () => {
    // Статус приходит снаружи через sendMessage; это просто триггер
    handlers.onStatus?.();
  });

  // ── Обработчик произвольного текста (режим чата / капча) ─────────────────
  tg.on('message', (msg) => {
    if (!msg.text) return;
    if (msg.text.startsWith('/')) return; // уже обработано выше

    if (waitState.captcha) {
      waitState.captcha = false;
      handlers.onCaptchaText?.(msg.text.trim());
      sendMessage(`🔐 Капча отправлена: ${msg.text.trim()}`);
      return;
    }

    if (waitState.chat) {
      handlers.onChatText?.(msg.text.trim());
      return; // не шлём подтверждение, чтобы не засорять
    }
  });

  // ── Callback inline-кнопок ────────────────────────────────────────────────
  tg.on('callback_query', async (query) => {
    const data = query.data || '';

    // Нажатие на слот меню сервера
    if (data.startsWith('slot:')) {
      const slot = parseInt(data.split(':')[1], 10);
      handlers.onSlotClick?.(slot);
      await tg.answerCallbackQuery(query.id, { text: `Клик по слоту ${slot}` });
      return;
    }

    // Кнопка "Ввести капчу"
    if (data === 'enter_captcha') {
      waitState.captcha = true;
      waitState.chat    = false;
      await tg.answerCallbackQuery(query.id, { text: 'Введите текст капчи следующим сообщением' });
      sendMessage('🔐 Напишите текст капчи:');
      return;
    }

    await tg.answerCallbackQuery(query.id);
  });

  console.log('[TG] Telegram-бот запущен');
}

// ─── Публичный API ────────────────────────────────────────────────────────────

/**
 * Отправить текстовое сообщение владельцу.
 * @param {string} text
 * @param {object} [opts]
 */
function sendMessage(text, opts = {}) {
  if (!tg) return;
  tg.sendMessage(cfg.TG_CHAT_ID, text, opts).catch(err =>
    console.error('[TG] sendMessage error:', err.message)
  );
}

/**
 * Отправить фото (буфер или путь) владельцу.
 * @param {Buffer|string} photo
 * @param {object} [opts]
 */
function sendPhoto(photo, opts = {}) {
  if (!tg) return;
  tg.sendPhoto(cfg.TG_CHAT_ID, photo, opts).catch(err =>
    console.error('[TG] sendPhoto error:', err.message)
  );
}

/**
 * Отправить список предметов меню как inline-кнопки.
 * @param {Array<{slot: number, name: string, lore: string[]}>} items
 */
function sendServerMenu(items) {
  if (!items.length) {
    sendMessage('⚠️ Меню пустое или не удалось прочитать предметы.');
    return;
  }

  // Отфильтруем декоративные панели (чтобы не спамить кнопками и текстом)
  const validItems = items.filter(it => {
    const lower = it.name.toLowerCase();
    if (lower.includes('stained glass pane') || lower.includes('stained_glass_pane') || lower.includes('стеклянная панель')) return false;
    if (it.name.trim() === '' && (!it.lore || it.lore.length === 0)) return false;
    return true;
  });

  let text = '🖥 *Меню выбора сервера:*\n\n';
  validItems.forEach(it => {
    let itemText = `• Слот ${it.slot}: *${escapeMarkdown(it.name)}*`;
    if (it.lore && it.lore.length > 0) {
      itemText += `\n  ℹ️ ${escapeMarkdown(it.lore.join(' | ').substring(0, 200))}`;
    }
    itemText += '\n';

    // Если текст становится слишком длинным, отправляем его и начинаем новый
    if (text.length + itemText.length > 3800) {
      sendMessage(text, { parse_mode: 'Markdown' });
      text = '';
    }
    text += itemText;
  });

  // Формируем кнопки (по 3 в ряд)
  const buttons = [];
  for (let i = 0; i < validItems.length; i += 3) {
    const row = validItems.slice(i, i + 3).map(it => ({
      text: `[${it.slot}] ${it.name.substring(0, 15)}`,
      callback_data: `slot:${it.slot}`,
    }));
    buttons.push(row);
  }

  tg.sendMessage(cfg.TG_CHAT_ID, text || 'Выберите сервер:', {
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: buttons,
    },
  }).catch(err => console.error('[TG] sendServerMenu error:', err.message));
}

/**
 * Отправить изображение капчи с кнопкой "Ввести капчу".
 * @param {Buffer} imageBuffer
 */
function sendCaptchaImage(imageBuffer) {
  tg.sendPhoto(cfg.TG_CHAT_ID, imageBuffer, {
    caption: '🔐 *Капча*\nНажмите кнопку и введите текст:',
    parse_mode: 'Markdown',
    reply_markup: {
      inline_keyboard: [[
        { text: '✏️ Ввести капчу', callback_data: 'enter_captcha' },
      ]],
    },
  }).catch(err => console.error('[TG] sendCaptchaImage error:', err.message));
}

/** Экранирует спецсимволы Markdown v1 */
function escapeMarkdown(text) {
  return String(text).replace(/([_*[\]()~`>#+=|{}.!-])/g, '\\$1');
}

/** Устанавливает флаг ожидания ввода капчи (вызывается из mcBot при обнаружении капчи) */
function setCaptchaWait(val) {
  waitState.captcha = !!val;
}

module.exports = { init, sendMessage, sendPhoto, sendServerMenu, sendCaptchaImage, setCaptchaWait };
