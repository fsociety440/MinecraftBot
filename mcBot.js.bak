/**
 * mcBot.js — Minecraft-часть
 *
 * Отвечает за:
 *  - создание mineflayer-бота и переподключение
 *  - все игровые действия (spawn, windowOpen, farm, look, chat)
 *  - регистрацию плагинов (pathfinder)
 *  - передачу событий в telegramBot.js
 */

const mineflayer  = require('mineflayer');
const { pathfinder } = require('mineflayer-pathfinder');
const cfg         = require('./config');
const tg          = require('./telegramBot');
const captcha     = require('./captcha');

// ─── Изменяемые настройки подключения (меняются через /setip) ────────────────
let currentHost = cfg.MC_HOST;
let currentPort = cfg.MC_PORT;

// ─── Состояние бота ───────────────────────────────────────────────────────────
/** @type {import('mineflayer').Bot|null} */
let bot = null;
let farmInterval = null;        // setInterval для фарма
let reconnectTimer = null;      // setTimeout для переподключения
let isConnected = false;
let openWindow = null;          // текущее открытое окно инвентаря
let antibotCheckPassed = false; // прошёл ли бот проверку на бота (по падению)

// ─── Создание бота ────────────────────────────────────────────────────────────

/**
 * Создаёт нового mineflayer-бота и навешивает все обработчики событий.
 */
function createBot() {
  // Чистим предыдущее состояние
  if (bot) {
    try { bot.quit(); } catch (_) {}
    bot = null;
  }
  isConnected = false;
  stopFarm();

  console.log(`[MC] Подключаюсь к ${currentHost}:${currentPort} как ${cfg.MC_USERNAME}…`);

  bot = mineflayer.createBot({
    host:        currentHost,
    port:        currentPort,
    username:    cfg.MC_USERNAME,
    version:     cfg.MC_VERSION,
    auth:        'offline',
    hideErrors:  false,
    // Явно задаём физический тик — важно для антибот-проверки по падению
    physicsEnabled: true,
  });

  // ── RAW-пакеты для диагностики ────────────────────────────────────────────
  // Перехватываем точную причину кика (иногда она не попадает в событие 'kicked')
  bot._client.on('kick_disconnect', (packet) => {
    console.warn('[MC RAW kick_disconnect]', JSON.stringify(packet));
    tg.sendMessage(`⛔ RAW кик: ${JSON.stringify(packet).substring(0, 200)}`);
  });

  // Логируем первые несколько пакетов позиции — убеждаемся, что физика работает
  let posPacketCount = 0;
  let botFilterInterval = null;

  bot._client.on('position', (packet) => {
    if (posPacketCount < 5) {
      console.log(`[MC POS #${posPacketCount}] x=${packet.x?.toFixed(2)} y=${packet.y?.toFixed(2)} z=${packet.z?.toFixed(2)} onGround=${packet.onGround} tpId=${packet.teleportId}`);
      posPacketCount++;
    }

    // Обязательно подтверждаем телепортацию (дублирование логики Mineflayer не нужно, но иногда помогает для BotFilter)
    if (packet.teleportId !== undefined) {
        bot._client.write('teleport_confirm', { teleportId: packet.teleportId });
    }
  });

  // ── Плагины ────────────────────────────────────────────────────────────────
  bot.loadPlugin(pathfinder);

  // ── Спавн (бот попал на сервер/хаб) ──────────────────────────────────────
  bot.once('spawn', () => {
    antibotCheckPassed = false; // сбрасываем флаг при каждом спавне
    console.log('[MC] Spawned!');
  });

  bot.on('login', () => {
    isConnected = true;
    console.log('[MC] Login packet received. Applying BotFilter physics bypass hooks...');
    tg.sendMessage(`✅ Бот *${cfg.MC_USERNAME}* вошёл на сервер (Login) \`${currentHost}:${currentPort}\``, {
      parse_mode: 'Markdown',
    });
    
    // Инициализируем слушатель карт, чтобы не пропустить пакеты до спавна рамок
    captcha.initMapListener(bot);

    // Включаем нормальную физику (чтобы бот падал для антибота)
    bot.physicsEnabled = true;

    // ── ОБХОД БОТФИЛЬТРА (ПАТЧ ФИЗИКИ) ─────────────────────────────────────
    // Если чанк не загружен, world.getBlock возвращает null, и физика Mineflayer 
    // перестаёт применять гравитацию. Мы подменяем функцию getBlock: 
    // если чанка нет, возвращаем воздух, чтобы бот падал.
    if (bot.world && !bot.world._originalGetBlock) {
      bot.world._originalGetBlock = bot.world.getBlock.bind(bot.world);
      bot.world.getBlock = (pos) => {
        const b = bot.world._originalGetBlock(pos);
        if (b === null || b === undefined) {
          // Если мы высоко (например, на y=512), возвращаем воздух, чтобы падать
          if (bot.entity && bot.entity.position && bot.entity.position.y > 200) {
            return { position: pos, type: 0, name: 'air', boundingBox: 'empty', transparent: true, shapes: [] };
          }
          // Иначе возвращаем воздух (физику отключим ниже)
          return { position: pos, type: 0, name: 'air', boundingBox: 'empty', transparent: true, shapes: [] };
        }
        return b;
      };
    }

    // Дебаг: логируем нашу позицию и скорость каждую секунду
    const debugTimer = setInterval(() => {
      if (!bot || !bot.entity) {
        return;
      }
      if (!antibotCheckPassed) {
         console.log(`[MC DEBUG] Y=${bot.entity.position?.y?.toFixed(2)} VelY=${bot.entity.velocity?.y?.toFixed(2)} onGround=${bot.entity.onGround}`);
         
         // Убрано отключение физики из таймера, перенесли в forcedMove
      } else {
         clearInterval(debugTimer);
      }
    }, 1000);

    bot.on('forcedMove', () => {
      if (bot.entity && bot.entity.position && bot.entity.position.y < 100 && bot.physicsEnabled && !antibotCheckPassed) {
         bot.physicsEnabled = false;
         bot.clearControlStates();
         console.log('[MC] Teleported to captcha room. Physics disabled immediately to prevent "Ошибка при обработке данных!".');
      }
    });

    let captchaDebounce = null;
    let lastCaptchaTime = 0;

    const triggerCaptchaCheck = () => {
      if (captchaDebounce) clearTimeout(captchaDebounce);
      captchaDebounce = setTimeout(async () => {
        captchaDebounce = null;
        if (!bot.entity || !bot.entity.position) return;
        
        const nearbyFrames = Object.values(bot.entities).filter(e => {
          if (!e || !e.name) return false;
          const n = e.name;
          if (n !== 'item_frame' && n !== 'glow_item_frame') return false;
          if (!e.position) return false;
          return e.position.distanceTo(bot.entity.position) <= 10;
        });
        
        const needed = Math.floor((cfg.CAPTCHA_COLS * cfg.CAPTCHA_ROWS) / 2);
        if (nearbyFrames.length >= needed) {
          const now = Date.now();
          if (now - lastCaptchaTime < 4000) {
            // Защита от спама, если карты обновляются слишком часто
            return;
          }
          lastCaptchaTime = now;
          console.log(`[MC] Обнаружена капча (${nearbyFrames.length} рамок). Собираю...`);
          tg.sendMessage(`🗺 Капча на экране! Собираю картинку…`);
          await captcha.captureAndSendCaptcha(bot);
        }
      }, 1500); // Ждем 1.5 сек после последнего спавна или обновления пакета
    };

    bot.on('entitySpawn', (entity) => {
      if (!entity || !entity.name) return;
      const isFrame = entity.name === 'item_frame' || entity.name === 'glow_item_frame';
      if (!isFrame) return;
      triggerCaptchaCheck();
    });

    bot.on('map_updated', () => {
      // Вызываем проверку только если мы в комнате капчи
      if (bot.entity && bot.entity.position && bot.entity.position.y < 100 && !bot.physicsEnabled && !antibotCheckPassed) {
        triggerCaptchaCheck();
      }
    });

  });

  // ── Открытие меню (Chest/GUI) ─────────────────────────────────────────────
  bot.on('windowOpen', (window) => {
    openWindow = window;
    console.log(`[MC] windowOpen: "${window.title}" (${window.slots.length} слотов)`);

    // Парсим предметы
    const items = [];
    for (let i = 0; i < window.slots.length; i++) {
      const item = window.slots[i];
      if (!item) continue;

      let rawName = item.customName;
      let name = extractJsonText(rawName);
      
      // Если customName оказался пустой оберткой без текста, берем стандартное имя (например, "Player Head")
      if (!name.trim()) {
        name = extractJsonText(item.displayName || item.name || `Item#${item.type}`);
      }

      const lore = (item.nbt?.value?.display?.value?.Lore?.value?.value || [])
        .map(l => stripColorCodes(extractJsonText(l)));

      items.push({ slot: i, name: stripColorCodes(name), lore });
    }

    // Отправляем список в Telegram
    tg.sendServerMenu(items);
  });

  // ── Закрытие окна ─────────────────────────────────────────────────────────
  bot.on('windowClose', () => {
    openWindow = null;
  });

  // ── Авто-возрождение ──────────────────────────────────────────────────────
  bot.on('death', () => {
    console.log('[MC] Бот умер, возрождаюсь...');
    tg.sendMessage('💀 Бот умер! Пытаюсь возродиться...');
    bot.spawn();
  });

  // ── Авто-еда (из левой руки) ──────────────────────────────────────────────
  let isEating = false;
  bot.on('health', async () => {
    // Если голод меньше 20 и не едим прямо сейчас
    if (bot.food < 20 && !isEating && bot.physicsEnabled) {
      isEating = true;
      console.log(`[MC] Голод: ${bot.food}/20. Кушаю из левой руки...`);
      try {
        bot.activateItem(true); // true = off-hand (левая рука)
        await sleep(2000);      // ждем, пока проиграется анимация поедания
        bot.deactivateItem();
      } catch (e) {
        console.error('[MC] Ошибка при авто-еде:', e.message);
      }
      isEating = false;
    }
  });

  // ── Игровой чат → в Telegram (для отладки) ────────────────────────────────
  bot.on('message', async (jsonMsg) => {
    const text = jsonMsg.toString();
    if (!text) return;
    console.log(`[MC chat] ${text}`);
    const lower = text.toLowerCase();

    // ── Определяем конец антибот-проверки (падение) ───────────────────────
    // Сервер пишет что-то вроде «Проверка пройдена», «Добро пожаловать», «Вы прошли»
    // Список ключевых фраз — дополните под ваш сервер при необходимости.
    const checkPassedPhrases = [
      'проверка пройдена',
      'добро пожаловать',
      'вы прошли',
      'welcome',
      'verification passed',
      'check passed',
      'успешно',
      'авторизуйтесь',  // часто выдаётся сразу после прохождения проверки
      '/login',
      '/reg',
    ];

    const isCheckPassed = checkPassedPhrases.some(p => lower.includes(p));

    if (isCheckPassed && !antibotCheckPassed) {
      antibotCheckPassed = true;
      bot.physicsEnabled = true; // Включаем нормальную физику обратно
      console.log('[MC] Антибот-проверка пройдена! Физика включена.');
      tg.sendMessage('✅ Антибот-проверка пройдена! Теперь можете использовать /usecompass для открытия меню серверов.');
    }

    // ── Пересылаем важные сообщения в TG ─────────────────────────────────
    if (
      lower.includes('captcha') ||
      lower.includes('капч') ||
      lower.includes('введите') ||
      lower.includes('verify') ||
      lower.includes('проверк') ||
      lower.includes('авторизуйтесь') ||
      lower.includes('/login') ||
      lower.includes('/reg')
    ) {
      tg.sendMessage(`💬 MC: ${text}`);
    }
  });

  // ── Кик ───────────────────────────────────────────────────────────────────
  bot.on('kicked', (reason) => {
    isConnected = false;
    const msg = tryParseReason(reason);
    console.warn(`[MC] Kicked: ${msg}`);
    tg.sendMessage(`⛔ Бот кикнут: *${escapeMarkdown(msg)}*\nПереподключение через 30 сек…`, {
      parse_mode: 'Markdown',
    });
    scheduleReconnect();
  });

  // ── Потеря соединения ─────────────────────────────────────────────────────
  bot.on('end', (reason) => {
    if (!isConnected) return; // уже обработали через kicked
    isConnected = false;
    console.warn(`[MC] Connection ended: ${reason}`);
    tg.sendMessage(`🔌 Соединение потеряно: ${reason}\nПереподключение через 30 сек…`);
    scheduleReconnect();
  });

  // ── Ошибка ────────────────────────────────────────────────────────────────
  bot.on('error', (err) => {
    console.error('[MC] Error:', err.message);
    // Не вызываем reconnect здесь — событие 'end' придёт следом
  });
}

// ─── Вспомогательные игровые действия ────────────────────────────────────────

/**
 * Ищет Компас в инвентаре и активирует его правой кнопкой мыши.
 */
async function useCompass() {
  try {
    // Ищем предмет с именем 'compass' в любом слоте инвентаря
    const compass = bot.inventory.items().find(item => item.name === 'compass');

    if (!compass) {
      console.warn('[MC] Компас не найден в инвентаре');
      tg.sendMessage('⚠️ Компас не найден в инвентаре. Открываю меню вручную не удастся.');
      return;
    }

    console.log(`[MC] Компас найден в слоте ${compass.slot}, беру в руку…`);

    // Экипируем компас в главную руку
    await bot.equip(compass, 'hand');
    await sleep(500);

    // Используем (ПКМ)
    bot.activateItem();
    console.log('[MC] Компас использован');
  } catch (err) {
    console.error('[MC] useCompass error:', err.message);
    tg.sendMessage(`❌ Ошибка при использовании компаса: ${err.message}`);
  }
}

/**
 * Кликает по слоту открытого окна.
 * @param {number} slotIndex
 */
async function clickSlot(slotIndex) {
  if (!bot || !isConnected) {
    tg.sendMessage('❌ Бот не подключён');
    return;
  }
  if (!openWindow) {
    tg.sendMessage('❌ Нет открытого окна');
    return;
  }
  try {
    // Параметры: окно, слот, кнопка (0=левый клик), режим (0=стандартный)
    await bot.clickWindow(slotIndex, 0, 0);
    console.log(`[MC] Клик по слоту ${slotIndex}`);
  } catch (err) {
    console.error('[MC] clickSlot error:', err.message);
    tg.sendMessage(`❌ Ошибка клика по слоту ${slotIndex}: ${err.message}`);
  }
}

/**
 * Отправляет текст в чат Minecraft.
 * @param {string} text
 */
function sendToChat(text) {
  if (!bot || !isConnected) {
    tg.sendMessage('❌ Бот не подключён');
    return;
  }
  try {
    bot.chat(text);
    console.log(`[MC] Чат → "${text}"`);
  } catch (err) {
    console.error('[MC] sendToChat error:', err.message);
  }
}

/**
 * Поворачивает взгляд бота.
 * @param {number} yaw   — горизонтальный угол (радианы)
 * @param {number} pitch — вертикальный угол (радианы)
 */
function lookAt(yaw, pitch) {
  if (!bot || !isConnected) {
    tg.sendMessage('❌ Бот не подключён');
    return;
  }
  try {
    bot.look(yaw, pitch, true);
    console.log(`[MC] look(yaw=${yaw.toFixed(3)}, pitch=${pitch.toFixed(3)})`);
  } catch (err) {
    console.error('[MC] look error:', err.message);
  }
}

// ─── Фарм ─────────────────────────────────────────────────────────────────────

/** Запускает цикл ударов. */
function startFarm() {
  if (farmInterval) return; // уже запущен
  console.log(`[MC] Фарм запущен (интервал ${cfg.FARM_INTERVAL_MS}ms)`);
  farmInterval = setInterval(() => {
    if (!bot || !isConnected) return;
    try {
      bot.swingArm('left');
    } catch (_) {}
  }, cfg.FARM_INTERVAL_MS);
}

/** Останавливает цикл ударов. */
function stopFarm() {
  if (farmInterval) {
    clearInterval(farmInterval);
    farmInterval = null;
    console.log('[MC] Фарм остановлен');
  }
}

// ─── Переподключение ──────────────────────────────────────────────────────────

function scheduleReconnect() {
  stopFarm();
  if (reconnectTimer) clearTimeout(reconnectTimer);
  reconnectTimer = setTimeout(() => {
    reconnectTimer = null;
    console.log('[MC] Переподключение…');
    tg.sendMessage('🔄 Переподключаюсь…');
    createBot();
  }, cfg.RECONNECT_DELAY_MS);
}

// ─── Инициализация ────────────────────────────────────────────────────────────

/**
 * Запускает Minecraft-бота и инициализирует Telegram-бота с нужными колбэками.
 */
function start() {
  tg.init({
    // Клик по слоту меню серверов
    onSlotClick: (slot) => clickSlot(slot),

    // Текст из режима чата → в MC
    onChatText: (text) => sendToChat(text),

    // Капча: ввод из TG → в MC
    onCaptchaText: (text) => {
      console.log(`[MC] Отвечаю на капчу: "${text}"`);
      sendToChat(text);
    },

    // Смена IP
    onSetIp: (host, port) => {
      currentHost = host;
      currentPort = port;
      tg.sendMessage(`🔄 Переподключаюсь к ${host}:${port}…`);
      createBot();
    },

    // Управление фармом
    onStartFarm: () => startFarm(),
    onStopFarm:  () => stopFarm(),

    // Взгляд
    onLook: (yaw, pitch) => lookAt(yaw, pitch),

    // /say команда
    onSayText: (text) => sendToChat(text),

    // Использование компаса
    onUseCompass: () => useCompass(),

    // Статус
    onStatus: () => {
      const status = isConnected
        ? `✅ Подключён к ${currentHost}:${currentPort}\nФарм: ${farmInterval ? 'активен' : 'остановлен'}`
        : `❌ Не подключён (${currentHost}:${currentPort})`;
      tg.sendMessage(status);
    },
  });

  // Запускаем Minecraft-бота
  createBot();
}

/**
 * Вешает слушатель на появление Item Frame — сигнал возможного появления капчи.
 * После того как несколько рамок появляются рядом, запускает captureAndSendCaptcha.
 */
function hookCaptchaDetection() {
  if (!bot) return;

  let captchaDebounce = null;

  bot.on('entitySpawn', (entity) => {
    if (!entity || !entity.name) return;
    const isFrame = entity.name === 'item_frame' || entity.name === 'glow_item_frame';
    if (!isFrame) return;

    // Дебаунс: ждём 2 сек после последней появившейся рамки, затем захватываем
    if (captchaDebounce) clearTimeout(captchaDebounce);
    captchaDebounce = setTimeout(async () => {
      captchaDebounce = null;
      const nearbyFrames = Object.values(bot.entities).filter(e => {
        if (!e || !e.name) return false;
        const isF = e.name === 'item_frame' || e.name === 'glow_item_frame';
        return isF && e.position.distanceTo(bot.entity.position) <= 10;
      });

      // Запускаем только если рамок достаточно (хотя бы COLS*ROWS / 2)
      const needed = Math.floor((cfg.CAPTCHA_COLS * cfg.CAPTCHA_ROWS) / 2);
      if (nearbyFrames.length >= needed) {
        console.log(`[MC] Обнаружена возможная капча (${nearbyFrames.length} рамок)`);
        tg.sendMessage(`🗺 Обнаружены рамки с картами (${nearbyFrames.length} шт.). Собираю капчу…`);
        await captcha.captureAndSendCaptcha(bot);
      }
    }, 2000);
  });

  console.log('[MC] Хук обнаружения капчи установлен');
}

// ─── Утилиты ──────────────────────────────────────────────────────────────────

/** Извлекает простой текст из Minecraft JSON Chat Component */
function extractJsonText(obj) {
  if (!obj) return '';
  if (typeof obj === 'string') {
    try {
      obj = JSON.parse(obj);
    } catch (e) {
      return obj; // Обычная строка
    }
  }

  let res = '';
  if (typeof obj === 'object' && obj !== null) {
    if (typeof obj.text === 'string') res += obj.text;
    if (Array.isArray(obj.extra)) {
      res += obj.extra.map(extractJsonText).join('');
    }
  }
  return res;
}

/** Убирает §-коды цвета из строки. */
function stripColorCodes(str) {
  return String(str).replace(/§[0-9a-fk-or]/gi, '').trim();
}

/** Пытается распарсить причину кика (JSON или строка). */
function tryParseReason(reason) {
  try {
    const obj = JSON.parse(reason);
    return obj.text || obj.translate || reason;
  } catch {
    return String(reason);
  }
}

/** Экранирует спецсимволы Markdown v1. */
function escapeMarkdown(text) {
  return String(text).replace(/([_*[\]()~`>#+=|{}.!-])/g, '\\$1');
}

/** Promise-обёртка над setTimeout. */
function sleep(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

module.exports = { start };
