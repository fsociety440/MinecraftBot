# Токен вашего Telegram-бота (от @BotFather)
TG_TOKEN=1234567890:AABBCCDDEEFF...

# Ваш личный Telegram chat_id (узнать: @userinfobot).
# Обязателен: бот выполняет команды только из этого чата.
TG_CHAT_ID=123456789

# ─── Minecraft ─────────────────────────────────────────────────────────────────
# Ник, IP и порт ботов задаются в Telegram (➕ Добавить бота).
# Версия протокола (по умолчанию 1.16.5)
# MC_VERSION=1.16.5

# ─── Фарм ──────────────────────────────────────────────────────────────────────
# Интервал удара в миллисекундах (1500 = 1.5 сек)
FARM_INTERVAL_MS=1500

# ─── Переподключение ────────────────────────────────────────────────────────────
# Задержка перед переподключением в миллисекундах (30000 = 30 сек)
RECONNECT_DELAY_MS=30000

# ─── Шахта (всё необязательно, в скобках — значения по умолчанию) ──────────────
# Радиус шахты в блоках от места, где включили шахту (10)
# MINER_RADIUS=10
# С какой высоты боту можно падать (64; на сервере с уроном от падения ставьте 3)
# MINER_MAX_DROP=64
# Что копать, через запятую (камень, булыжник, андезит, диорит, гранит и все руды)
# MINER_BLOCKS=stone,cobblestone,iron_ore,redstone_ore,lapis_ore,gold_ore,coal_ore,diamond_ore,emerald_ore
# Есть при сытости ≤ (14)
# MINER_EAT_AT=14
# Чинить бур пузырьками при прочности ≤ (100)
# MINER_REPAIR_AT=100
