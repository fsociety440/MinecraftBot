# Токен вашего Telegram-бота (от @BotFather)
TG_TOKEN=1234567890:AABBCCDDEEFF...

# Ваш личный Telegram chat_id (узнать: @userinfobot)
TG_CHAT_ID=123456789

# ─── Minecraft ─────────────────────────────────────────────────────────────────
# IP и порт хаб-сервера (можно менять на лету через /setip в Telegram)
MC_HOST=play.example.com
MC_PORT=25565

# Ник бота (только латиница, без пробелов)
MC_USERNAME=MyBot

# ─── Фарм ──────────────────────────────────────────────────────────────────────
# Интервал удара в миллисекундах (1500 = 1.5 сек)
FARM_INTERVAL_MS=1500

# ─── Переподключение ────────────────────────────────────────────────────────────
# Задержка перед переподключением в миллисекундах (30000 = 30 сек)
RECONNECT_DELAY_MS=30000
